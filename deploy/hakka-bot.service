[Unit]
Description=Hakka (Mandarin -> Hakka) Telegram Bot
# 等網路真的通了再啟動（Pi 開機時網路可能還沒好）
After=network-online.target
Wants=network-online.target
# 開機後若一直起不來（例如網路慢），5 分鐘內最多重試 10 次
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple

# ↓↓↓ 依你的環境修改這三行 ↓↓↓
User=pi
WorkingDirectory=/home/pi/hakka-translation
ExecStart=/home/pi/hakka-translation/.venv/bin/python bot.py
# ↑↑↑ 依你的環境修改這三行 ↑↑↑

# 當掉自動重啟
Restart=on-failure
RestartSec=10

# 讓 print 立即寫進 journal
Environment=PYTHONUNBUFFERED=1

# 基本安全隔離（選用；若造成問題可整段拿掉）
# 注意：ReadWritePaths 要跟上面的 WorkingDirectory 一致
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/pi/hakka-translation

[Install]
WantedBy=multi-user.target
