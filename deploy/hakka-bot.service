# 參考範本 —— 建議直接用 `bash deploy/install.sh`（會自動填好使用者和路徑）。
# 若要手動安裝，把下面 3 個 __佔位符__ 換成你的實際值，
# 存到 /etc/systemd/system/hakka-bot.service：
#
#   __USER__  你的登入帳號（在 Pi 上執行 `id -un` 查）
#   __DIR__   專案絕對路徑（在專案裡執行 `pwd` 查，例如 /home/andy/hakka-translation）

[Unit]
Description=Hakka (Mandarin -> Hakka) Telegram Bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python bot.py
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
