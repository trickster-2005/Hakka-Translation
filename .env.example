# ---- 必填 ----
# 跟 @BotFather 申請 bot 後拿到的 token
TELEGRAM_BOT_TOKEN=

# ---- 建議填（私人 bot）----
# 只允許這些 Telegram user id 使用，逗號分隔。留空 = 任何人都能用。
# 傳 /id 給 bot 可查到自己的 id。
ALLOWED_USER_IDS=

# ---- 選填 ----
# 預設腔調：hailu（海陸）或 sixian（四縣）
HAKKA_DIALECT=hailu
# 預設語音：F（女聲）或 M（男聲）
HAKKA_VOICE=F
# 音檔輸出方式：
#   audio = mp3 音樂卡片（可下載）
#   doc   = mp3 檔案，不會進 Telegram 音樂播放器、不會自動接續播放（最不吵）
#   voice = 語音訊息（圓形波形，Telegram 會自動接續播放前後則）
#   both  = voice + audio
#   wav   = wav 檔案
#   off   = 不送音檔
SEND_AUDIO_AS=audio
# 語速 0.5–2.0
SPEAKING_RATE=1.0

# 單則訊息最多字數
MAX_INPUT_CHARS=180
# 每日翻譯字數上限（匿名約 1000；填了 HAKKA_COOKIE 可設 10000）
DAILY_CHAR_LIMIT=1000

# 登入後的 cookie 字串，用來取得帳號 10000 字/日 額度。
# 取得方式：瀏覽器登入 speech.hakka.gov.tw 後開 F12 →
# Network → 任一個 speech.hakka.gov.tw 請求 → Request Headers → 複製整段 Cookie 值。
# 留空則以匿名方式使用。
HAKKA_COOKIE=

# curl_cffi 模擬的瀏覽器指紋（chrome / chrome124 / edge 等）
HTTP_IMPERSONATE=chrome
